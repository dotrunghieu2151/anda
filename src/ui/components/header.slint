// Header component for the application
// Provides consistent branding and title display

export component AppHeader {
    in property <string> title: "Anda - Real-time Transcription & Translation";
    in property <string> subtitle: "";
    height: 80px;
    Rectangle {
        VerticalLayout {
            padding: 20px;
            spacing: 4px;
            alignment: center;
            Text {
                text: root.title;
                font-size: 28px;
                font-weight: 800;
                color: #00d9ff;
                horizontal-alignment: center;
            }

            if !root.subtitle.is-empty: Text {
                text: root.subtitle;
                font-size: 14px;
                font-weight: 400;
                color: #6c757d;
                horizontal-alignment: center;
            }
        }
        
        // Bottom border line
        Rectangle {
            y: parent.height - 1px;
            width: 100%;
            height: 1px;
            background: #1a1a2e;
        }
    }
}
