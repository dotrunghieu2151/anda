// Audio visualization section component
// Uses the WaveformVisualizer component for displaying audio waveforms

import { GroupBox } from "std-widgets.slint";
import { WaveformVisualizer } from "./wave-form.slint";

export component AudioVisualizationSection {
    in property <string> waveform-path: "";
    GroupBox {
        title: "Audio Input Visualization";
        WaveformVisualizer {
            width: 100%;
            height: 200px;
            drawCommands: root.waveform-path;
            background: #111;
        }
    }
}
