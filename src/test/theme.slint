// ============================================================
// VoiceScribe AI — Design Tokens (Global Singleton)
// ============================================================
export global AppTheme {
  // --- Background Layers ---
  out property <color> bg-primary:      #0b0f1a;
  out property <color> bg-surface:      #0f1623;
  out property <color> bg-elevated:     #1e2736;
  out property <color> bg-overlay:      #141c2e;
  out property <color> bg-panel:        #161c2d;
  out property <color> bg-panel-alt:    #12182a;
  // --- Borders ---
  out property <color> border-subtle:   rgba(255, 255, 255, 0.07);
  out property <color> border-muted:    rgba(255, 255, 255, 0.05);
  out property <color> border-strong:   rgba(255, 255, 255, 0.12);
  // --- Text ---
  out property <color> text-primary:    #e2e8f0;
  out property <color> text-secondary:  #94a3b8;
  out property <color> text-muted:      #475569;
  out property <color> text-dim:        #334155;
  // --- Accent Colors ---
  out property <color> accent-blue:     #63b3ed;
  out property <color> accent-purple:   #9f7aea;
  out property <color> accent-green:    #48bb78;
  out property <color> accent-red:      #fc8181;
  out property <color> accent-orange:   #ed8936;
  // --- Interactive States ---
  out property <color> btn-primary:           #3b82f6;
  out property <color> btn-primary-hover:     #2563eb;
  out property <color> btn-primary-glow:      rgba(59, 130, 246, 0.30);
  out property <color> btn-danger:            rgba(229, 62, 62, 0.15);
  out property <color> btn-danger-border:     rgba(252, 129, 129, 0.50);
  out property <color> btn-surface:           rgba(255, 255, 255, 0.05);
  out property <color> btn-surface-hover:     rgba(255, 255, 255, 0.10);
  // --- Typography ---
  out property <length> font-xs:     10px;
  out property <length> font-sm:     11px;
  out property <length> font-base:   13px;
  out property <length> font-md:     14px;
  out property <length> font-lg:     16px;
  // --- Spacing ---
  out property <length> sp-1:   4px;
  out property <length> sp-2:   8px;
  out property <length> sp-3:   12px;
  out property <length> sp-4:   16px;
  out property <length> sp-5:   20px;
  out property <length> sp-6:   24px;
  // --- Border Radius ---
  out property <length> radius-sm:   4px;
  out property <length> radius-md:   8px;
  out property <length> radius-lg:   12px;
  out property <length> radius-xl:   16px;
  out property <length> radius-full: 9999px;
  // --- Animation Durations ---
  out property <duration> anim-fast:   120ms;
  out property <duration> anim-normal: 220ms;
  out property <duration> anim-slow:   380ms;
}